# Copy to packages/backend/.env — never commit real keys.

PORT=3000
NODE_ENV=production

# Microsoft OAuth
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=https://auto-button-tagging.kro.kr/api/auth/microsoft/callback
AZURE_AD_TENANT=common

# Firecrawl key pool (comma-separated). Analysis picks the key with most remaining credits.
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_API_KEYS=

# LLM — OpenRouter
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-3.5-flash

# Optional: PostgreSQL. If unset, embedded PGlite is used.
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/autotag
# PGLITE_DATA_DIR=/opt/autotag/data/pglite

# Batch concurrency (keep Firecrawl ≤2 to avoid session kills)
FIRECRAWL_QUEUE_CONCURRENCY=2
LLM_QUEUE_CONCURRENCY=4
CAPTURE_QUEUE_CONCURRENCY=3
